#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D inputImage;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = textureSize(inputImage, 0);

    // Clamp to avoid out-of-bounds writes
    if (pixel.x >= imageSize.x || pixel.y >= imageSize.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(imageSize);
    
    // Use a 5x5 kernel (radius = 2)
    const int radius = 2;
    const int kernelSize = radius * 2 + 1;
    float samples[25];
    int index = 0;
    for (int y = -radius; y <= radius; y++) {
        for (int x = -radius; x <= radius; x++) {
            vec2 offset = vec2(float(x), float(y)) * texelSize;
            vec2 uv = (vec2(pixel) + 0.5) * texelSize + offset;
            vec3 color = texture(inputImage, uv).rgb;
            samples[index] = dot(color, vec3(0.299, 0.587, 0.114));
            index++;
        }
    }

    // Sobel 5x5 kernels
    float gx = 0.0;
    float gy = 0.0;
    
    // 5x5 Sobel-X kernel
    float sobelX[25] = float[25](
        -2, -1, 0, 1, 2,
        -2, -1, 0, 1, 2,
        -4, -2, 0, 2, 4,
        -2, -1, 0, 1, 2,
        -2, -1, 0, 1, 2
    );
    
    // 5x5 Sobel-Y kernel
    float sobelY[25] = float[25](
        -2, -2, -4, -2, -2,
        -1, -1, -2, -1, -1,
         0,  0,  0,  0,  0,
         1,  1,  2,  1,  1,
         2,  2,  4,  2,  2
    );
    
    for (int i = 0; i < 25; i++) {
        gx += samples[i] * sobelX[i];
        gy += samples[i] * sobelY[i];
    }

    float edgeStrength = sqrt(gx * gx + gy * gy);

    // Write the result to the output image
    // Clamp the edge strength and use it to color the pixel
    float edgeAmount = clamp(edgeStrength * 3.0, 0.0, 1.0); // Scale the edge strength for better visibility
    vec3 finalColor = mix(vec3(1.0, 1.0, 1.0), vec3(0.0, 0.0, 0.0), edgeAmount);    

    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}